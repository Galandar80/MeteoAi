{
  "functions": {
    "api/localized-page.js": {
      "includeFiles": "{index.html,world-live.html,installa.html,i18n.js}"
    }
  },
  "redirects": [
    {
      "source": "/meteo/:country",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/come-funziona", "destination": "/api/about-page?lang=it" },
    { "source": "/en/how-it-works", "destination": "/api/about-page?lang=en" },
    { "source": "/fr/comment-ca-marche", "destination": "/api/about-page?lang=fr" },
    { "source": "/pt-br/como-funciona", "destination": "/api/about-page?lang=pt-BR" },
    { "source": "/es/como-funciona", "destination": "/api/about-page?lang=es" },
    { "source": "/widget", "destination": "/api/widget-page?lang=it" },
    { "source": "/en/widget", "destination": "/api/widget-page?lang=en" },
    { "source": "/fr/widget", "destination": "/api/widget-page?lang=fr" },
    { "source": "/pt-br/widget", "destination": "/api/widget-page?lang=pt-BR" },
    { "source": "/es/widget", "destination": "/api/widget-page?lang=es" },
    { "source": "/embed/weather", "destination": "/api/weather-widget" },
    {
      "source": "/en",
      "destination": "/api/localized-page?lang=en&page=home"
    },
    {
      "source": "/fr",
      "destination": "/api/localized-page?lang=fr&page=home"
    },
    {
      "source": "/pt-br",
      "destination": "/api/localized-page?lang=pt-BR&page=home"
    },
    {
      "source": "/es",
      "destination": "/api/localized-page?lang=es&page=home"
    },
    {
      "source": "/en/world-live",
      "destination": "/api/localized-page?lang=en&page=world"
    },
    {
      "source": "/fr/world-live",
      "destination": "/api/localized-page?lang=fr&page=world"
    },
    {
      "source": "/pt-br/world-live",
      "destination": "/api/localized-page?lang=pt-BR&page=world"
    },
    {
      "source": "/es/world-live",
      "destination": "/api/localized-page?lang=es&page=world"
    },
    {
      "source": "/en/install",
      "destination": "/api/localized-page?lang=en&page=install"
    },
    {
      "source": "/fr/install",
      "destination": "/api/localized-page?lang=fr&page=install"
    },
    {
      "source": "/pt-br/install",
      "destination": "/api/localized-page?lang=pt-BR&page=install"
    },
    {
      "source": "/es/install",
      "destination": "/api/localized-page?lang=es&page=install"
    },
    {
      "source": "/sitemaps/localita-attive.xml",
      "destination": "/api/seo-sitemap?kind=locations"
    },
    {
      "source": "/localita",
      "destination": "/api/locations-index"
    },
    {
      "source": "/en/locations",
      "destination": "/api/locations-index?lang=en"
    },
    {
      "source": "/fr/localites",
      "destination": "/api/locations-index?lang=fr"
    },
    {
      "source": "/pt-br/localidades",
      "destination": "/api/locations-index?lang=pt-BR"
    },
    {
      "source": "/es/localidades",
      "destination": "/api/locations-index?lang=es"
    },
    {
      "source": "/pt-br/previsao/:country/:region/:place",
      "destination": "/api/meteo-page?lang=pt-BR&country=:country&region=:region&place=:place"
    },
    {
      "source": "/en/weather/:country/:region/:place",
      "destination": "/api/meteo-page?lang=en&country=:country&region=:region&place=:place"
    },
    {
      "source": "/fr/meteo/:country/:region/:place",
      "destination": "/api/meteo-page?lang=fr&country=:country&region=:region&place=:place"
    },
    {
      "source": "/es/tiempo/:country/:region/:place",
      "destination": "/api/meteo-page?lang=es&country=:country&region=:region&place=:place"
    },
    {
      "source": "/meteo/:country/:region/:place",
      "destination": "/api/meteo-page?country=:country&region=:region&place=:place"
    }
  ],
  "headers": [
    {
      "source": "/meteo/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/pt-br/previsao/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/en/weather/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/fr/meteo/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/es/tiempo/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
